    m_Metadata:
      m_Items: []
  - m_Id: 1009664332
    m_Localized: "\u0428\u043B\u0435\u043C \u043C\u0435\u0447\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664333
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u043D\u043E: {1} \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664334
    m_Localized: "{1}: \u043D\u0435\u0443\u0434\u0430\u0447\u0430, \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664335
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u043F\u0440\u0435\u0440\u0432\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664336
    m_Localized: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
      \u0440\u0435\u0446\u0435\u043F\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664337
    m_Localized: "\u0412\u044B \u0443\u0436\u0435 \u0447\u0442\u043E-\u0442\u043E
      \u0441\u043E\u0437\u0434\u0430\u0451\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664338
    m_Localized: "\u041D\u0435\u043B\u044C\u0437\u044F \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0432 \u0431\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664339
    m_Localized: "\u0411\u043E\u0435\u0432\u043E\u0439 \u043B\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664340
    m_Localized: "(\u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u043E {0})"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664341
    m_Localized: "\u2192 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664342
    m_Localized: "{0} \u2192 {1}: \u2212{2} {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664343
    m_Localized: "{0} \u2192 {1}: +{2} {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664344
    m_Localized: "{0} \u043F\u043E\u0433\u0438\u0431\u0430\u0435\u0442 ({1})"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664345
    m_Localized: "{0}: {1} \xD7{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664346
    m_Localized: "{0}: {1} \u2014 \u0441\u043F\u0430\u0434\u0430\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664347
    m_Localized: "\u0413\u043E\u0440\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664348
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0443\u0440\u043E\u043D \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443.
      \u0421\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0434\u043E
      3 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664349
    m_Localized: "\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664350
    m_Localized: "\u041D\u0435\u043B\u044C\u0437\u044F \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u043D\u0430\u0432\u044B\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664351
    m_Localized: "\u0420\u0430\u0441\u043A\u043E\u043B \u0431\u0440\u043E\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664352
    m_Localized: "\u041E\u0431\u043E\u0440\u043E\u043D\u0430 \u0441\u043D\u0438\u0436\u0435\u043D\u0430
      \u043D\u0430 5% \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0437\u0430\u0440\u044F\u0434
      (\u0434\u043E 3)."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664353
    m_Localized: "\u0427\u0430\u0440\u043E\u0434\u0435\u0439\u0441\u043A\u0438\u0439
      \u0449\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664354
    m_Localized: "\u041F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442 \u0443\u0440\u043E\u043D,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0438\u0441\u0441\u044F\u043A\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664355
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0435 \u0434\u044B\u0445\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664356
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043A\u0430\u0436\u0434\u0443\u044E
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664357
    m_Localized: "\u0416\u0435\u043B\u0435\u0437\u043D\u0430\u044F \u043A\u043E\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664358
    m_Localized: "\u041E\u0431\u043E\u0440\u043E\u043D\u0430 +10%."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664359
    m_Localized: "\u042F\u0440\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664360
    m_Localized: "\u0423\u0440\u043E\u043D +15%."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664361
    m_Localized: "\u042D\u043B\u0438\u043A\u0441\u0438\u0440 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439
      \u043A\u043E\u0436\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664362
    m_Localized: "\u041D\u0430 30 \u0441 \u043E\u0431\u043E\u0440\u043E\u043D\u0430
      +10%. \u0417\u0430\u043C\u0435\u043D\u044F\u0435\u0442 \u0434\u0440\u0443\u0433\u0438\u0435
      \u044D\u043B\u0438\u043A\u0441\u0438\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664363
    m_Localized: "\u042D\u043B\u0438\u043A\u0441\u0438\u0440 \u044F\u0440\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664364
    m_Localized: "\u041D\u0430 30 \u0441 \u0443\u0440\u043E\u043D +15%. \u0417\u0430\u043C\u0435\u043D\u044F\u0435\u0442
      \u0434\u0440\u0443\u0433\u0438\u0435 \u044D\u043B\u0438\u043A\u0441\u0438\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664365
    m_Localized: "\u0412\u044B \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664366
    m_Localized: "\u0412\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u043D\u0430\u0432\u044B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664367
    m_Localized: "\u0421\u0435\u0439\u0447\u0430\u0441 \u044D\u0442\u043E \u043D\u0435\u043B\u044C\u0437\u044F
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664368
    m_Localized: "\u0412\u043E\u043B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664369
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u0433\u043E\u043B\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664370
    m_Localized: "\u0423\u043A\u0443\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664371
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u0443\u043A\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664372
    m_Localized: "\u0421\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0438\u0439
      \u0443\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664373
    m_Localized: "\u0423\u0434\u0430\u0440, \u043E\u0433\u043B\u0443\u0448\u0430\u044E\u0449\u0438\u0439
      \u0446\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664374
    m_Localized: "\u0421\u043E\u043A\u0440\u0443\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664375
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0443\u0434\u0430\u0440
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u043C \u043A\u0443\u043B\u0430\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664376
    m_Localized: "\u041B\u043E\u0433\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664377
    m_Localized: "\u041F\u0430\u0440\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664378
    m_Localized: "\u0414\u043B\u044F \xAB\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F\xBB.
      \u041D\u043E\u0432\u044B\u0439 \u043B\u043E\u0433\u0438\u043D \u2014 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F
      \u043F\u0440\u0438 \u043F\u0435\u0440\u0432\u043E\u043C \u0432\u0445\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664379
    m_Localized: "\u043B\u043E\u0433\u0438\u043D 3\u201320 \u0431\u0443\u043A\u0432/\u0446\u0438\u0444\u0440,
      \u043F\u0430\u0440\u043E\u043B\u044C \u043D\u0435 \u043A\u043E\u0440\u043E\u0447\u0435
      4 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664380
    m_Localized: "\u043D\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043F\u0430\u0440\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664381
    m_Localized: "\u0438\u043C\u044F \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430:
      2\u201316 \u0431\u0443\u043A\u0432, \u0446\u0438\u0444\u0440, \u043F\u0440\u043E\u0431\u0435\u043B\u043E\u0432,
      _ \u0438\u043B\u0438 -"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664382
    m_Localized: "\u0442\u0430\u043A\u043E\u0435 \u0438\u043C\u044F \u0443\u0436\u0435
      \u0437\u0430\u043D\u044F\u0442\u043E \u0434\u0440\u0443\u0433\u0438\u043C \u0438\u0433\u0440\u043E\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664383
    m_Localized: "\u0432 \u044D\u0442\u043E\u0442 \u0430\u043A\u043A\u0430\u0443\u043D\u0442
      \u0432\u043E\u0448\u043B\u0438 \u0441 \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664384
    m_Localized: "\u0441\u0435\u0441\u0441\u0438\u044F \u0443\u0441\u0442\u0430\u0440\u0435\u043B\u0430
      \u2014 \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u0430\u0440\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664385
    m_Localized: "\u042D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u0443\u0436\u0435 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664386
    m_Localized: "\u042D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u043D\u0435 \u0434\u043B\u044F \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664387
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u0431\u043B\u0438\u0436\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664388
    m_Localized: "\u041E\u0442\u0441\u0435\u043A \u043F\u043E\u043B\u043E\u043D \u2014
      {1} \xD7{0} \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435,
      \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664389
    m_Localized: "\u0410\u0432\u0442\u043E\u043F\u043E\u0434\u0431\u043E\u0440 \u0434\u043E\u0431\u044B\u0447\u0438:
      \u0412\u041A\u041B (\u043D\u0430\u0436\u043C\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0442\u044C \u0432\u0440\u0443\u0447\u043D\u0443\u044E)"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664390
    m_Localized: "\u0410\u0432\u0442\u043E\u043F\u043E\u0434\u0431\u043E\u0440 \u0434\u043E\u0431\u044B\u0447\u0438:
      \u0412\u042B\u041A\u041B \u2014 \u0434\u043E\u0431\u044B\u0447\u0430 \u043B\u0435\u0436\u0438\u0442
      \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 (\u043D\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664391
    m_Localized: "\u043F\u0443\u0441\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664392
    m_Localized: "\u25C7 \u0421\u043B\u043E\u0442 ({0}): {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664393
    m_Localized: "\u044F\u0434\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664394
    m_Localized: "\u0434\u0443\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664395
    m_Localized: "\u043C\u0438\u043D\u0435\u0440\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664396
    m_Localized: "\u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664397
    m_Localized: "\u0412\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0432 \u0441\u043B\u043E\u0442: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664398
    m_Localized: "\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044C \xAB{0}\xBB \u0432
      \u0441\u043B\u043E\u0442 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664399
    m_Localized: "\u0417\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0432 \u0441\u043B\u043E\u0442\u0435
      {1} \u043D\u0430 \xAB{0}\xBB (\u0441\u0442\u0430\u0440\u044B\u0439 \u043F\u0440\u043E\u043F\u0430\u0434\u0451\u0442)"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664400
    m_Localized: "\u041D\u0435\u0442 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0445
      \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
