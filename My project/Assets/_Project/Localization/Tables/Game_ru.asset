    m_Metadata:
      m_Items: []
  - m_Id: 1009664497
    m_Localized: "\u041E\u0442\u043E\u0437\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664498
    m_Localized: "\u041D\u0435 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C:
      \u0448\u0430\u0433 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u043E\u0431\u043C\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664499
    m_Localized: "{0} \xD7{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664500
    m_Localized: "\u0421\u044E\u0434\u0430 \u043D\u0435\u043B\u044C\u0437\u044F \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664501
    m_Localized: "\u042D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F \u0432 \u0434\u0440\u0443\u0433\u043E\u043C
      \u043E\u0442\u0441\u0435\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664502
    m_Localized: "\u0417\u0430\u044F\u0432\u043A\u0438 \u043E\u0442 \u044D\u0442\u043E\u0433\u043E
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664503
    m_Localized: "\u0417\u0430\u044F\u0432\u043A\u0430 \u0443\u0436\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664504
    m_Localized: "\u0423 \u044D\u0442\u043E\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430
      \u043D\u0435\u0442 \u043C\u0435\u0441\u0442\u0430 \u0432 \u0434\u0440\u0443\u0437\u044C\u044F\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664505
    m_Localized: "\u0412\u043A\u043B\u0430\u0434\u043A\u0438 \u043D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B:
      \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0438 \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0434\u0438\u043D \u043A\u0430\u043D\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664506
    m_Localized: "{1} \u0445\u043E\u0447\u0435\u0442 \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
      \u0432\u0430\u0441 \u0432 \u0434\u0440\u0443\u0437\u044C\u044F (\u043E\u043A\u043D\u043E
      \xAB\u0414\u0440\u0443\u0437\u044C\u044F\xBB)"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664507
    m_Localized: "{1} \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u0430\u0448 \u0434\u0440\u0443\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664508
    m_Localized: "\u0421\u0443\u043C\u043A\u0430: \u043D\u0430\u0436\u043C\u0438\u0442\u0435
