    m_Metadata:
      m_Items: []
  - m_Id: 1009664099
    m_Localized: "\u041A\u043E\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664100
    m_Localized: "\u041B\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664101
    m_Localized: "\u041F\u043E\u0441\u043E\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664102
    m_Localized: "\u0416\u0435\u0437\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664103
    m_Localized: "\u041C\u0435\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664104
    m_Localized: "\u0422\u043E\u043F\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664105
    m_Localized: "\u0429\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664106
    m_Localized: "\u041C\u0430\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664107
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u0438\u0439 \u0443\u0440\u043E\u043D,
      \u0442\u044F\u043D\u0435\u0442 \u0441\u0438\u043B\u0443 \u0438\u0437 \u043E\u0431\u043E\u0438\u0445
      \u043F\u0443\u043B\u043E\u0432 \u043C\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664108
    m_Localized: "\u0412\u043E\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664109
    m_Localized: "\u0411\u043B\u0438\u0436\u043D\u0438\u0439 \u0431\u043E\u0439,
      \u0436\u0435\u0440\u0442\u0432\u0443\u0435\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\u043C
      \u0440\u0430\u0434\u0438 \u0441\u0438\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664110
    m_Localized: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0448\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664111
    m_Localized: "\u0411\u0440\u043E\u0441\u0430\u0435\u0442 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439
      \u0448\u0430\u0440 \u0432\u043E \u0432\u0440\u0430\u0433\u0430. \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      \u043F\u0440\u0435\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u0430\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664112
    m_Localized: "\u0422\u0430\u0439\u043D\u043E\u0435 \u0438\u0441\u0446\u0435\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664113
    m_Localized: "\u041B\u0435\u0447\u0438\u0442 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430
      \u0438\u043B\u0438 \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664114
    m_Localized: "\u0412\u0441\u043F\u044B\u0448\u043A\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664115
    m_Localized: "\u041C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0439 \u0443\u0434\u0430\u0440,
      \u0442\u0440\u0430\u0442\u0438\u0442 \u0438 \u043E\u0441\u043D\u043E\u0432\u043D\u0443\u044E,
      \u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u0443\u044E \u043C\u0430\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664116
    m_Localized: "\u041C\u043E\u0449\u043D\u044B\u0439 \u0443\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664117
    m_Localized: "\u0421\u0438\u043B\u044C\u043D\u044B\u0439 \u0443\u0434\u0430\u0440
      \u043E\u0440\u0443\u0436\u0438\u0435\u043C \u043F\u043E \u0446\u0435\u043B\u0438
      \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664118
    m_Localized: "\u041A\u0440\u043E\u0432\u0430\u0432\u044B\u0439 \u0443\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664119
    m_Localized: "\u041F\u043B\u0430\u0442\u0438\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\u043C
      \u0437\u0430 \u0441\u0438\u043B\u0443. \u041C\u043E\u0436\u0435\u0442 \u0443\u0431\u0438\u0442\u044C
      \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664120
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0435 \u0434\u044B\u0445\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664121
    m_Localized: "\u041B\u0435\u0447\u0438\u0442 \u0441\u0435\u0431\u044F \u0437\u0430
      \u0441\u0447\u0451\u0442 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u043E\u0439
      \u043C\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664122
    m_Localized: "\u041F\u043E\u0441\u043E\u0445 \u0443\u0447\u0435\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664123
    m_Localized: "\u0414\u0432\u0443\u0440\u0443\u0447\u043D\u044B\u0439 \u043F\u043E\u0441\u043E\u0445
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0449\u0435\u0433\u043E \u043C\u0430\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664124
    m_Localized: "\u0422\u043A\u0430\u043D\u0435\u0432\u044B\u0439 \u043A\u0430\u043F\u044E\u0448\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664125
    m_Localized: "\u041B\u0451\u0433\u043A\u0438\u0439 \u043A\u0430\u043F\u044E\u0448\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664126
    m_Localized: "\u041C\u0430\u043D\u0442\u0438\u044F \u0430\u0434\u0435\u043F\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664127
    m_Localized: "\u041C\u0430\u043D\u0442\u0438\u044F, \u0443\u043A\u0440\u0435\u043F\u043B\u044F\u044E\u0449\u0430\u044F
      \u0440\u0435\u0437\u0435\u0440\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664128
    m_Localized: "\u041A\u043E\u043B\u044C\u0446\u043E \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664129
    m_Localized: "\u041F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0448\u0430\u043D\u0441
      \u0438 \u0440\u0430\u0437\u043C\u0435\u0440 \u043A\u0440\u0438\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664130
    m_Localized: "\u0416\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u0448\u043B\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664131
    m_Localized: "\u041B\u0430\u0442\u043D\u044B\u0439 \u0448\u043B\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664132
    m_Localized: "\u041B\u0430\u0442\u043D\u044B\u0439 \u0434\u043E\u0441\u043F\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664133
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439, \u043D\u043E \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664134
    m_Localized: "\u041A\u043E\u0436\u0430\u043D\u044B\u0435 \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664135
    m_Localized: "\u0423\u0434\u043E\u0431\u043D\u044B\u0435 \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664136
    m_Localized: "\u0416\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u043C\u0435\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664137
    m_Localized: "\u041E\u0434\u043D\u043E\u0440\u0443\u0447\u043D\u044B\u0439 \u043C\u0435\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664138
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439 \u0449\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664139
    m_Localized: "\u0429\u0438\u0442 \u0432\u043E \u0432\u0442\u043E\u0440\u0443\u044E
      \u0440\u0443\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664140
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0442\u043E\u043F\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664141
    m_Localized: "\u0414\u0432\u0443\u0440\u0443\u0447\u043D\u044B\u0439 \u0442\u043E\u043F\u043E\u0440,
      \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0432\u043E\u0438\u043D\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664142
    m_Localized: "\u0417\u0435\u043B\u044C\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664143
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664144
    m_Localized: "\u0417\u0435\u043B\u044C\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u043C\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664145
    m_Localized: "\u0412 \u0431\u043E\u044E \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u0432\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664146
    m_Localized: "\u0417\u0435\u043B\u044C\u0435 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u043E\u0439
      \u043C\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664147
    m_Localized: "\u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
      \u0432\u043E\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0440\u0435\u0437\u0435\u0440\u0432.
      \u0412 \u0431\u043E\u044E \u2014 \u0432\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664148
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u044B\u0439
      \u043C\u0430\u043D\u0435\u043A\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664149
    m_Localized: "\u041F\u0440\u043E\u0447\u043D\u044B\u0439 \u043C\u0430\u043D\u0435\u043A\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664150
    m_Localized: "\u0422\u0430\u043B\u0430\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664151
    m_Localized: "\u041A\u0430\u0440\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664152
    m_Localized: "\u041F\u0435\u0440\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664153
    m_Localized: "\u0420\u044E\u043A\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664154
    m_Localized: "\u0422\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664155
    m_Localized: "\u041A\u0430\u0440\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664156
    m_Localized: "\u0423\u043C\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664157
    m_Localized: "\u041D\u0430\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664158
    m_Localized: "\u041A\u043B\u0430\u0432\u0438\u0448\u0430: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664159
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664160
    m_Localized: "\u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664161
    m_Localized: "\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B:"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664162
    m_Localized: "\u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438:"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664163
    m_Localized: "\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664164
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u043C\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664165
    m_Localized: "\u0420\u0435\u0437\u0435\u0440\u0432\u043D\u0430\u044F \u043C\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664166
    m_Localized: "\u0412\u043E\u0441\u0441\u0442. \u0440\u0435\u0437\u0435\u0440\u0432\u0430/\u0441
      (\u0432\u043D\u0435 \u0431\u043E\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664167
    m_Localized: "{0} \u0443\u0440\u043E\u0432\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664168
    m_Localized: "\u0421\u0438\u043D\u0438\u0439 \u2014 \u0432\u044B, \u0446\u0432\u0435\u0442\u043D\u044B\u0435
      \u2014 \u043C\u0430\u043D\u0435\u043A\u0435\u043D\u044B. \u041A\u043B\u0430\u0432\u0438\u0448\u0430
      M \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u0430\u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664169
    m_Localized: "\u042D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664170
    m_Localized: "\u0420\u0430\u0441\u0445\u043E\u0434\u043D\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664171
