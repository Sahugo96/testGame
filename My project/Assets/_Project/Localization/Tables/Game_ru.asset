    m_Metadata:
      m_Items: []
  - m_Id: 1009664543
    m_Localized: "\u0423\u0440. \u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664544
    m_Localized: "\u0421\u043B\u043E\u0442\u043E\u0432 \u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664545
    m_Localized: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664546
    m_Localized: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664547
    m_Localized: "{0} \u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664548
    m_Localized: "\u041D\u0430\u0439\u0434\u0435\u043D\u043E: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664549
    m_Localized: "\u0431\u0435\u0441\u0441\u0440\u043E\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664550
    m_Localized: "\u043B\u044E\u0431\u043E\u0439 \u043A\u0443\u0437\u043D\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664551
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664552
    m_Localized: "\u041B\u041A\u041C \u2014 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
      \u0434\u043B\u044F \u0437\u0430\u043A\u0430\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664553
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u0437\u0430\u043A\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664554
    m_Localized: "\u041D\u043E\u0432\u044B\u0439 \u0437\u0430\u043A\u0430\u0437:
      \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442,
      \u043E\u043F\u043B\u0430\u0442\u0443 \u0438 (\u0435\u0441\u043B\u0438 \u043D\u0443\u0436\u043D\u043E)
      \u0438\u043C\u044F \u043A\u0443\u0437\u043D\u0435\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664555
    m_Localized: "\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664556
    m_Localized: "\u041E\u043F\u043B\u0430\u0442\u0430 (\u0437\u043E\u043B\u043E\u0442\u043E)"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664557
    m_Localized: "\u041A\u0443\u0437\u043D\u0435\u0446 (\u043F\u0443\u0441\u0442\u043E
      \u2014 \u043B\u044E\u0431\u043E\u0439)"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664558
    m_Localized: "{0} \u2192 {1}, {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664559
    m_Localized: "\u0417\u0430\u043A\u0430\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664560
    m_Localized: "\u041B\u041A\u041C \u2014 \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043F\u043E \u0446\u0435\u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664561
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u043B\u0430\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664562
    m_Localized: "\u0421\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0434\u043B\u044F \u043B\u0430\u0432\u043A\u0438: \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
      \u0438 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043B\u0430\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664563
    m_Localized: "\xAB{0}\xBB, \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 {1}\n\u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0435\u0449\u0451: {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664564
    m_Localized: "\u0412\u044B\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0438\u0437
      \u0441\u0443\u043C\u043A\u0438 (\u0441\u0442\u043E\u043F\u043A\u0430 \u0446\u0435\u043B\u0438\u043A\u043E\u043C):"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664565
    m_Localized: "\u0426\u0435\u043D\u0430 \u0437\u0430 \u0448\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664566
    m_Localized: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043B\u0430\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664567
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043B\u0430\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664568
    m_Localized: "\u0426\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664569
    m_Localized: "{0}: \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u044F {1}%, \u0434\u043E
      {2} \u043B\u043E\u0442\u043E\u0432, {3} \u0447, \u0430\u0440\u0435\u043D\u0434\u0430
      {4} \u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664570
    m_Localized: "\u0421\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664571
    m_Localized: "{0} \u0434\u043D. {1} \u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664572
