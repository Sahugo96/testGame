    m_Metadata:
      m_Items: []
  - m_Id: 1009664629
    m_Localized: "\u041D\u043E\u0432\u043E\u0435 \u043F\u0438\u0441\u044C\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664630
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664631
    m_Localized: "\u0412\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664632
    m_Localized: "\u041B\u0430\u0432\u043A\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430
      \u043D\u0430 {0} \u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664633
    m_Localized: "\u041B\u0430\u0432\u043A\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430,
      \u043D\u0435\u0440\u0430\u0441\u043F\u0440\u043E\u0434\u0430\u043D\u043D\u043E\u0435
      \u2014 \u043D\u0430 \u043F\u043E\u0447\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664634
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u043D\u043E: {1} \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664635
    m_Localized: "\u041A\u0443\u043F\u043B\u0435\u043D\u043E: {1} \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664636
    m_Localized: "\u041A\u0443\u043F\u043B\u0435\u043D\u043E: {1} \xD7{0} \u2014
      \u0432 \u0441\u0443\u043C\u043A\u0435 \u043D\u0435\u0442 \u043C\u0435\u0441\u0442\u0430,
      \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E \u043D\u0430 \u043F\u043E\u0447\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664637
    m_Localized: "\u0417\u0430\u043A\u0430\u0437 \u2116{0} \u0441\u043E\u0437\u0434\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664638
    m_Localized: "\u0417\u0430\u043A\u0430\u0437 \u2116{0} \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D,
      \u043E\u043F\u043B\u0430\u0442\u0430 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664639
    m_Localized: "\u0417\u0430\u043A\u0430\u0437 \u2116{0} \u043E\u0442\u043C\u0435\u043D\u0451\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664640
    m_Localized: "\u042D\u0442\u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438
      \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u0432 \u0430\u043A\u043A\u0430\u0443\u043D\u0442\u0435
      \u0438 \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u0442\u0441\u044F \u043D\u0430
      \u0434\u0440\u0443\u0433\u043E\u043C \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664641
    m_Localized: "\u0412\u0441\u0451 \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664642
    m_Localized: "\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664643
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664644
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u043E\u0432\u043E\u0435
      \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435? \u0412\u0435\u0440\u043D\u0451\u0442\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 {0} \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664645
    m_Localized: "\u041A\u043B\u0430\u0432\u0438\u0448\u0430 \xAB{0}\xBB \u0443\u0436\u0435
      \u0437\u0430\u043D\u044F\u0442\u0430: \xAB{1}\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664646
    m_Localized: "\u0427\u0438\u0441\u043B\u0430 \u0443\u0440\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664647
    m_Localized: "\u041F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664648
    m_Localized: "\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435
      \u043A\u0430\u0434\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664649
    m_Localized: "\u0413\u0440\u0430\u0444\u0438\u043A\u0430 \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
      \u043D\u0430 \u044D\u0442\u043E\u043C \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0435.
      \u041D\u043E\u0432\u043E\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664650
    m_Localized: "\u0418\u043D\u0432\u0435\u0440\u0441\u0438\u044F \u043F\u043E \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664651
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664652
    m_Localized: "\u041A\u043B\u0430\u0432\u0438\u0448\u0438: \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0448\u0443, \u0437\u0430\u0442\u0435\u043C
      \u043D\u043E\u0432\u0443\u044E (Esc \u2014 \u043E\u0442\u043C\u0435\u043D\u0430).
      \u0425\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u0432 \u0430\u043A\u043A\u0430\u0443\u043D\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1009664653
    m_Localized: "\u2212"
    m_Metadata:
      m_Items: []
  - m_Id: 1009664654
    m_Localized: "\u041F\u043E\u043B\u043E\u0441\u044B \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
